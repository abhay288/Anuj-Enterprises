# Anuj Enterprises Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Atlas Production URI
MONGODB_URI=mongodb://localhost:27017/anuj_enterprises

# JWT Secret Keys
JWT_SECRET=anuj_enterprises_jwt_super_secret_key_2026_prod
JWT_REFRESH_SECRET=anuj_enterprises_refresh_super_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Resend Email API Key Configuration
RESEND_API_KEY=re_your_resend_api_key_here

# Cloudinary CDN Image Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=anuj_fmcg_products
CLOUDINARY_FOLDER=anuj_enterprises/products
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
