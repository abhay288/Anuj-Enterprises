# Anuj Enterprises Backend Environment Configuration Template
PORT=5000
NODE_ENV=development

# MongoDB Atlas Production URI
MONGODB_URI=mongodb://localhost:27017/anuj_enterprises

# JWT Secret Keys
JWT_SECRET=anuj_enterprises_jwt_super_secret_key_2026_prod
JWT_REFRESH_SECRET=anuj_enterprises_refresh_super_secret_key_2026
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173

# Resend Email API Key Configuration
RESEND_API_KEY=re_your_resend_api_key_here

# Production External Image Storage Configuration
IMAGE_STORAGE_URL=https://images.unsplash.com
IMAGE_STORAGE_KEY=your_storage_access_key
IMAGE_STORAGE_SECRET=your_storage_secret_key
